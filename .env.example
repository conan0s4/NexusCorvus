# Copy this file to .env to override the quick-start defaults.
# Every variable is optional - docker compose up works without a .env file.

# MySQL
# MYSQL_DATABASE=nexuscorvus
# MYSQL_USER=valorian
# MYSQL_PASSWORD=A123b456cRTc
# MYSQL_ROOT_PASSWORD=rootpassword

# Django (backend container)
# DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Admin account auto-created on first start
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=admin123
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# Reuse an existing MySQL instead of the bundled container one
# (e.g. your local MySQL already holding your data):
# DB_HOST=host.docker.internal
# DB_PORT=3301